#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: nix run .#update-telemetry [-- --write]

Fetch the upstream telemetry catalog and show the proposed snapshot update.
Use --write to apply the update to modules/shared/config/do-not-track.env.
EOF
}

write=false
for arg in "$@"; do
  case "$arg" in
  --write) write=true ;;
  --help|-h) usage; exit 0 ;;
  *) echo "unknown option: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

repo_root=${TELEMETRY_UPDATE_ROOT:-$(git rev-parse --show-toplevel)}
target="$repo_root/modules/shared/config/do-not-track.env"
upstream_repo=${TELEMETRY_UPDATE_REPO:-https://github.com/alloydwhitlock/do-not-track-cli.git}
upstream_commit=${TELEMETRY_UPDATE_COMMIT:-}

if [[ ! -f "$target" ]]; then
  echo "telemetry snapshot not found: $target" >&2
  exit 1
fi

if ! grep -Fq '# nixos-config local telemetry additions: begin' "$target" ||
  ! grep -Fq '# nixos-config local telemetry additions: end' "$target"; then
  echo "local telemetry addition markers are missing from $target" >&2
  exit 1
fi

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT
upstream="$tmp_dir/upstream.env"
local_block="$tmp_dir/local.env"
candidate="$tmp_dir/candidate.env"
merged="$tmp_dir/merged.env"
metadata_file="$tmp_dir/metadata.env"

if [[ -z "$upstream_commit" && -z "${TELEMETRY_UPDATE_SOURCE:-}" ]]; then
  upstream_commit=$(git ls-remote "$upstream_repo" refs/heads/main | awk 'NR == 1 { print $1 }')
fi

if [[ -z "${TELEMETRY_UPDATE_SOURCE:-}" ]]; then
  if [[ -z "$upstream_commit" ]]; then
    echo "could not determine the upstream commit" >&2
    exit 1
  fi
  source="https://raw.githubusercontent.com/alloydwhitlock/do-not-track-cli/$upstream_commit/do_not_track.env"
else
  source="$TELEMETRY_UPDATE_SOURCE"
fi

if [[ "$source" == http://* || "$source" == https://* ]]; then
  curl --fail --location --silent --show-error "$source" >"$upstream"
else
  cp "$source" "$upstream"
fi

if ! grep -Fq '# do_not_track.env' "$upstream" ||
  ! grep -Fq '# Aggressive / Opt-in' "$upstream"; then
  echo "upstream file has an unexpected format: $source" >&2
  exit 1
fi

awk '
  /# nixos-config local telemetry additions: begin/ { capture = 1 }
  capture { print }
  /# nixos-config local telemetry additions: end/ { exit }
' "$target" >"$local_block"

imported_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
cat >"$metadata_file" <<EOF
# Snapshot metadata (managed by nix run .#update-telemetry -- --write)
# Upstream repository: $upstream_repo
# Upstream commit: ${upstream_commit:-local-test-source}
# Imported at: $imported_at
# End snapshot metadata
EOF

awk -v local_file="$local_block" '
  {
    if ($0 == "# Serverless & FaaS") {
      while ((getline line < local_file) > 0) print line
      close(local_file)
      print ""
      print previous
      print
      previous = ""
      have_previous = 0
      next
    }
    if (have_previous) print previous
    previous = $0
    have_previous = 1
  }
  END { if (have_previous) print previous }
' "$upstream" >"$merged"

{
  awk -v metadata_file="$metadata_file" '
    { print }
    /^# Contributing: see README\.md$/ {
      while ((getline line < metadata_file) > 0) print line
      close(metadata_file)
    }
  ' "$merged"
} >"$candidate"

strip_metadata() {
  sed '/^# Snapshot metadata /,/^# End snapshot metadata$/d' "$1"
}

if diff -q <(strip_metadata "$target") <(strip_metadata "$candidate") >/dev/null; then
  echo "Telemetry snapshot is already up to date."
  exit 0
fi

if [[ "$write" != true ]]; then
  diff -u "$target" "$candidate" || true
  echo
  echo "Dry run only. Re-run with --write to update the snapshot."
  exit 0
fi

cp "$candidate" "$target"
echo "Updated $target from $source."
